# Python
__pycache__/
*.pyc
.venv/
venv/
env/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Data -- raw/processed datasets can be large; keep out of git.
# A README in data/ documents how to regenerate them.
**/data/raw/*
**/data/processed/*
!**/data/raw/.gitkeep
!**/data/processed/.gitkeep

# Trained models -- regenerable, can be large
**/models/*
!models/.gitkeep

# Environment / secrets
.env

# IDE
.vscode/
.idea/
.DS_Store

# Streamlit
.streamlit/secrets.toml
